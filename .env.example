# Leave empty in development: the app calls /api/... and the Vite dev server proxies it.
# Only set this for a production build hosted somewhere the backend's CORS allows.
VITE_API_URL=

# Where the Vite dev proxy forwards /api (the local backend by default).
# Use https://bank-transaction-system-wdkl.onrender.com to develop against the deployed API.
VITE_PROXY_TARGET=http://localhost:3000
